// Project 25 (Meridian Pay) -- load all 24 measures into SM_MeridianPay_DirectLake
// Generated by 04_Model/measures.py. Do not hand-edit; edit that file and regenerate.
//
// HOW TO USE -- DAX query view, NOT TMDL view.
//   1. Open SM_MeridianPay_DirectLake -> DAX query view.
//   2. Paste this whole file into a new query tab.
//   3. Run. The EVALUATE at the bottom is a smoke test -- it returns one row.
//   4. Click 'Update model with changes'. It should report 24.
//
// WHY NOT TMDL VIEW. P25_measures.tmdl opens with `table alerts`, and applying a
// partial table block in TMDL view REPLACES that table's definition -- it would drop
// the column and partition metadata the Direct Lake binding depends on. DEFINE MEASURE
// is purely additive and cannot remove anything. Use the .tmdl file for review and for
// the E3 export; use this file to actually load them.
//
// THERE IS A CHEAPER ROUTE, PROVEN 2026-08-19. The Power BI MCP server's
// batch_measure_operations BatchCreate applies P25_measures_batch.json over XMLA in
// one transactional call (24/24 in 0.7s) AND carries formatString, which DEFINE
// MEASURE does not. Use this file when XMLA is unavailable or an interactive sign-in
// cannot be completed.
//
// FORMAT STRINGS ARE NOT CARRIED BY DEFINE MEASURE. After applying, set these
// 7 in Model view -> select measure -> Format. Everything else defaults acceptably:
//     Approval Rate %                  -> 0.0%
//     Decline Rate %                   -> 0.0%
//     Estate Coverage %                -> 0.0%
//     Precision (Ground Truth)         -> 0.0%
//     Precision (Disputes)             -> 0.0%
//     Recall (Ground Truth)            -> 0.0%
//     Precision (Reportable)           -> 0.0%

DEFINE

    // Authorisation attempts only. event_type filters out reversals and partial captures, which
    // are separate events against the same auth and would double-count.
    MEASURE alerts[Total Auths] =
        CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth" )

    // Approved authorisations.
    MEASURE alerts[Approved Auths] =
        CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth", auth_curated[auth_result] = "approved" )

    // Declined authorisations.
    MEASURE alerts[Declined Auths] =
        CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth", auth_curated[auth_result] = "declined" )

    // DIVIDE, not '/', so an empty filter context returns BLANK rather than an error.
    MEASURE alerts[Approval Rate %] =
        DIVIDE ( [Approved Auths], [Total Auths] )

    // Complement of approval rate over the same denominator.
    MEASURE alerts[Decline Rate %] =
        DIVIDE ( [Declined Auths], [Total Auths] )

    // 600 at the frozen scale. Read from dim_estate, never hand-typed on a card.
    MEASURE alerts[Merchants] =
        DISTINCTCOUNT ( dim_estate[merchant_id] )

    // 927 at the frozen scale -- the +3% tolerance edge of the 900 proposed, not a miss.
    MEASURE alerts[Stores] =
        DISTINCTCOUNT ( dim_estate[store_id] )

    // 1,500 at the frozen scale. dim_estate is one row per terminal, so this also equals COUNTROWS
    // -- a divergence between the two means duplicates.
    MEASURE alerts[Terminals] =
        DISTINCTCOUNT ( dim_estate[terminal_id] )

    // entity_type guard is load-bearing: reflex 4 rows carry an issuer BIN in entity_id, and
    // counting those as terminals would inflate this silently.
    MEASURE alerts[Terminals with Alerts] =
        CALCULATE ( DISTINCTCOUNT ( alerts[entity_id] ), alerts[entity_type] = "terminal" )

    // Share of the estate that has ever raised an alert. Low is good news, not a gap.
    MEASURE alerts[Estate Coverage %] =
        DIVIDE ( [Terminals with Alerts], [Terminals] )

    // The denominator of every precision measure.
    MEASURE alerts[Alerts Raised] =
        COUNTROWS ( alerts )

    // The contract's '4 reflexes, >=1 fired with evidence' exit criterion, as a number the report
    // actually renders. Expect 4.
    MEASURE alerts[Reflex Types Fired] =
        DISTINCTCOUNT ( alerts[reflex_type] )

    // Disputes raised as of SIM_NOW -- 6,715 against an eventual ~13.5k. This is a maturity
    // effect, not a shortfall; the Home card's subtitle must say so.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Disputes Matured] =
        COUNTROWS ( dispute_curated )

    // True positives against the injected episode register. Both guards are needed: the KQL
    // grading writes an empty string, not a null, for an unmatched alert.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Alerts Matched (Ground Truth)] =
        CALCULATE ( COUNTROWS ( alerts ), NOT ISBLANK ( alerts[gt_episode_id] ), alerts[gt_episode_id] <> "" )

    // True positives against real chargebacks -- the independent second opinion the contract
    // requires alongside ground truth.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Alerts Confirmed (Disputes)] =
        CALCULATE ( COUNTROWS ( alerts ), alerts[dispute_confirmed] = TRUE () )

    // Unguarded. Do NOT bind this to a visual directly -- use Precision (Reportable).
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Precision (Ground Truth)] =
        DIVIDE ( [Alerts Matched (Ground Truth)], [Alerts Raised] )

    // Unguarded, same warning as above.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Precision (Disputes)] =
        DIVIDE ( [Alerts Confirmed (Disputes)], [Alerts Raised] )

    // Recall's denominator. The SWITCH exists because exactly one name differs between the two
    // vocabularies: reflex_type 'terminal_dark' is episode_type 'terminal_dark_outage'. Mapping it
    // in one place stops that mismatch becoming a silent zero. Unfiltered this returns 137.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Episodes In Scope] =
        VAR RefTypes = VALUES ( alerts[reflex_type] )
        VAR EpTypes =
            SELECTCOLUMNS (
                RefTypes,
                "@episode_type",
                SWITCH (
                    alerts[reflex_type],
                    "terminal_dark", "terminal_dark_outage",
                    alerts[reflex_type]
                )
            )
        RETURN
            CALCULATE (
                COUNTROWS ( ground_truth ),
                TREATAS ( EpTypes, ground_truth[episode_type] )
            )

    // Distinct real episodes the reflexes caught. Distinct, not a row count: one episode
    // legitimately produces many 5-minute alert buckets.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Episodes Detected] =
        CALCULATE ( DISTINCTCOUNT ( alerts[gt_episode_id] ), alerts[gt_episode_id] <> "" )

    // Report by reflex_type, NOT by maturity cohort. Cohort is a property of an alert's age; a
    // ground-truth episode has no cohort, so a per-cohort recall has no honest denominator. Stated
    // here so the page does not invent one.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Recall (Ground Truth)] =
        DIVIDE ( [Episodes Detected], [Episodes In Scope] )

    // The label the Alert Precision table shows instead of a number for any cohort that is not
    // fully graded. SELECTEDVALUE returns BLANK on a mixed selection, which is exactly the case
    // that must never render a percentage.
    MEASURE alerts[Cohort Status] =
        VAR C = SELECTEDVALUE ( alerts[maturity_cohort] )
        RETURN
            SWITCH (
                C,
                "graded_T90_T60", "Graded",
                "partially_matured_T60_T30", "Partially matured / not reportable",
                "awaiting_grading_T30_T", "Awaiting grading",
                BLANK (), "Mixed cohorts / select one",
                C
            )

    // THE GUARD. Blank -- not zero -- for every cohort that is not fully graded, and blank for a
    // mixed selection. Bind visuals to this, never to the unguarded measures. Zero would render as
    // a confident wrong bar; blank renders as the 'pending' state the contract's exit criteria
    // require.
    // PENDING DEPENDENCY: see MODEL_NOTES.md.
    MEASURE alerts[Precision (Reportable)] =
        VAR C = SELECTEDVALUE ( alerts[maturity_cohort] )
        RETURN
            IF ( C = "graded_T90_T60", [Precision (Ground Truth)], BLANK () )

    // Rules passing in the latest RUN, scoped by run_id. dq_results keeps every run and never
    // overwrites, so an unfiltered count would sum history and always look healthy -- but run_time
    // is a per-rule stamp, so scoping by it counts one rule (P25 S7 read-back defect). The floor
    // is required for every rule; the independent downstream check is required for rules 1-3 and
    // is BLANK by design for 4-6 (contract SS7), so BLANK counts as passing. A rule that found
    // nothing but proved it read nothing still has not passed -- that is what floor_satisfied
    // encodes.
    MEASURE alerts[DQ Rules Passed] =
        VAR LatestTime =
            CALCULATE ( MAX ( dq_results[run_time] ), ALL ( dq_results ) )
        VAR LatestRunId =
            CALCULATE (
                MAX ( dq_results[run_id] ),
                ALL ( dq_results ),
                dq_results[run_time] = LatestTime
            )
        RETURN
            CALCULATE (
                COUNTROWS (
                    FILTER (
                        dq_results,
                        dq_results[run_id] = LatestRunId
                            && dq_results[floor_satisfied] = TRUE ()
                            && ( ISBLANK ( dq_results[independent_check_passed] )
                                || dq_results[independent_check_passed] = TRUE () )
                    )
                ),
                ALL ( dq_results )
            )

    // Rows flagged across every rule in the latest RUN, scoped by run_id. RENAMED from 'DQ Faults
    // Found' 2026-08-19 (Session 7) because that noun was wrong: rule 5 (payload_schema_evolution)
    // contributes 2,151,584 of the 2,185,579, and its own detail JSON calls those rows carrying
    // the v2 sca_flag -- a population, not a fault. Rule 4 likewise reports all 1,500 terminals as
    // having nonzero clock skew, which is the expected state. The sum is kept whole rather than
    // narrowed to a hard-coded list of 'real fault' rules, because that list would rot the moment
    // a rule is added; the DqTbl beneath the card shows the per-rule split. Guide SS94.
    MEASURE alerts[DQ Rows Flagged] =
        VAR LatestTime =
            CALCULATE ( MAX ( dq_results[run_time] ), ALL ( dq_results ) )
        VAR LatestRunId =
            CALCULATE (
                MAX ( dq_results[run_id] ),
                ALL ( dq_results ),
                dq_results[run_time] = LatestTime
            )
        RETURN
            CALCULATE (
                SUM ( dq_results[faults_found] ),
                ALL ( dq_results ),
                dq_results[run_id] = LatestRunId
            )

// Smoke test. A non-BLANK Alerts Raised proves the measures bound to a real table
// rather than merely parsing.
EVALUATE
    ROW (
        "Alerts Raised", [Alerts Raised],
        "Terminals", [Terminals],
        "Reflex Types Fired", [Reflex Types Fired]
    )
