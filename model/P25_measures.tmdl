/// Project 25 (Meridian Pay) -- measure layer for SM_MeridianPay_DirectLake
/// Generated by 04_Model/measures.py -- edit that file, never this one.
/// Paste these into the `alerts` table in the service's TMDL view, or apply
/// P25_measures_batch.json over XMLA.

table alerts

	/// Authorisation attempts only. event_type filters out reversals and partial
	/// captures, which are separate events against the same auth and would
	/// double-count.
	measure 'Total Auths' = ```
			CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth" )
			```
		formatString: #,0
		displayFolder: 01 Volume

	/// Approved authorisations.
	measure 'Approved Auths' = ```
			CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth", auth_curated[auth_result] = "approved" )
			```
		formatString: #,0
		displayFolder: 01 Volume

	/// Declined authorisations.
	measure 'Declined Auths' = ```
			CALCULATE ( COUNTROWS ( auth_curated ), auth_curated[event_type] = "auth", auth_curated[auth_result] = "declined" )
			```
		formatString: #,0
		displayFolder: 01 Volume

	/// DIVIDE, not '/', so an empty filter context returns BLANK rather than an
	/// error.
	measure 'Approval Rate %' = ```
			DIVIDE ( [Approved Auths], [Total Auths] )
			```
		formatString: 0.0%
		displayFolder: 01 Volume

	/// Complement of approval rate over the same denominator.
	measure 'Decline Rate %' = ```
			DIVIDE ( [Declined Auths], [Total Auths] )
			```
		formatString: 0.0%
		displayFolder: 01 Volume

	/// 600 at the frozen scale. Read from dim_estate, never hand-typed on a card.
	measure 'Merchants' = ```
			DISTINCTCOUNT ( dim_estate[merchant_id] )
			```
		formatString: #,0
		displayFolder: 02 Estate

	/// 927 at the frozen scale -- the +3% tolerance edge of the 900 proposed, not
	/// a miss.
	measure 'Stores' = ```
			DISTINCTCOUNT ( dim_estate[store_id] )
			```
		formatString: #,0
		displayFolder: 02 Estate

	/// 1,500 at the frozen scale. dim_estate is one row per terminal, so this
	/// also equals COUNTROWS -- a divergence between the two means duplicates.
	measure 'Terminals' = ```
			DISTINCTCOUNT ( dim_estate[terminal_id] )
			```
		formatString: #,0
		displayFolder: 02 Estate

	/// entity_type guard is load-bearing: reflex 4 rows carry an issuer BIN in
	/// entity_id, and counting those as terminals would inflate this silently.
	measure 'Terminals with Alerts' = ```
			CALCULATE ( DISTINCTCOUNT ( alerts[entity_id] ), alerts[entity_type] = "terminal" )
			```
		formatString: #,0
		displayFolder: 02 Estate

	/// Share of the estate that has ever raised an alert. Low is good news, not a
	/// gap.
	measure 'Estate Coverage %' = ```
			DIVIDE ( [Terminals with Alerts], [Terminals] )
			```
		formatString: 0.0%
		displayFolder: 02 Estate

	/// The denominator of every precision measure.
	measure 'Alerts Raised' = ```
			COUNTROWS ( alerts )
			```
		formatString: #,0
		displayFolder: 03 Alerts

	/// The contract's '4 reflexes, >=1 fired with evidence' exit criterion, as a
	/// number the report actually renders. Expect 4.
	measure 'Reflex Types Fired' = ```
			DISTINCTCOUNT ( alerts[reflex_type] )
			```
		formatString: 0
		displayFolder: 03 Alerts

	/// Disputes raised as of SIM_NOW -- 6,715 against an eventual ~13.5k. This is
	/// a maturity effect, not a shortfall; the Home card's subtitle must say so.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Disputes Matured' = ```
			COUNTROWS ( dispute_curated )
			```
		formatString: #,0
		displayFolder: 03 Alerts

	/// True positives against the injected episode register. Both guards are
	/// needed: the KQL grading writes an empty string, not a null, for an
	/// unmatched alert.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Alerts Matched (Ground Truth)' = ```
			CALCULATE ( COUNTROWS ( alerts ), NOT ISBLANK ( alerts[gt_episode_id] ), alerts[gt_episode_id] <> "" )
			```
		formatString: #,0
		displayFolder: 04 Precision

	/// True positives against real chargebacks -- the independent second opinion
	/// the contract requires alongside ground truth.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Alerts Confirmed (Disputes)' = ```
			CALCULATE ( COUNTROWS ( alerts ), alerts[dispute_confirmed] = TRUE () )
			```
		formatString: #,0
		displayFolder: 04 Precision

	/// Unguarded. Do NOT bind this to a visual directly -- use Precision
	/// (Reportable).
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Precision (Ground Truth)' = ```
			DIVIDE ( [Alerts Matched (Ground Truth)], [Alerts Raised] )
			```
		formatString: 0.0%
		displayFolder: 04 Precision

	/// Unguarded, same warning as above.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Precision (Disputes)' = ```
			DIVIDE ( [Alerts Confirmed (Disputes)], [Alerts Raised] )
			```
		formatString: 0.0%
		displayFolder: 04 Precision

	/// Recall's denominator. The SWITCH exists because exactly one name differs
	/// between the two vocabularies: reflex_type 'terminal_dark' is episode_type
	/// 'terminal_dark_outage'. Mapping it in one place stops that mismatch
	/// becoming a silent zero. Unfiltered this returns 137.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Episodes In Scope' = ```
			VAR RefTypes = VALUES ( alerts[reflex_type] )
			VAR EpTypes =
			    SELECTCOLUMNS (
			        RefTypes,
			        "@episode_type",
			        SWITCH (
			            alerts[reflex_type],
			            "terminal_dark", "terminal_dark_outage",
			            alerts[reflex_type]
			        )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( ground_truth ),
			        TREATAS ( EpTypes, ground_truth[episode_type] )
			    )
			```
		formatString: #,0
		displayFolder: 04 Precision

	/// Distinct real episodes the reflexes caught. Distinct, not a row count: one
	/// episode legitimately produces many 5-minute alert buckets.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Episodes Detected' = ```
			CALCULATE ( DISTINCTCOUNT ( alerts[gt_episode_id] ), alerts[gt_episode_id] <> "" )
			```
		formatString: #,0
		displayFolder: 04 Precision

	/// Report by reflex_type, NOT by maturity cohort. Cohort is a property of an
	/// alert's age; a ground-truth episode has no cohort, so a per-cohort recall
	/// has no honest denominator. Stated here so the page does not invent one.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Recall (Ground Truth)' = ```
			DIVIDE ( [Episodes Detected], [Episodes In Scope] )
			```
		formatString: 0.0%
		displayFolder: 04 Precision

	/// The label the Alert Precision table shows instead of a number for any
	/// cohort that is not fully graded. SELECTEDVALUE returns BLANK on a mixed
	/// selection, which is exactly the case that must never render a percentage.
	measure 'Cohort Status' = ```
			VAR C = SELECTEDVALUE ( alerts[maturity_cohort] )
			RETURN
			    SWITCH (
			        C,
			        "graded_T90_T60", "Graded",
			        "partially_matured_T60_T30", "Partially matured / not reportable",
			        "awaiting_grading_T30_T", "Awaiting grading",
			        BLANK (), "Mixed cohorts / select one",
			        C
			    )
			```
		displayFolder: 04 Precision

	/// THE GUARD. Blank -- not zero -- for every cohort that is not fully graded,
	/// and blank for a mixed selection. Bind visuals to this, never to the
	/// unguarded measures. Zero would render as a confident wrong bar; blank
	/// renders as the 'pending' state the contract's exit criteria require.
	/// PENDING DEPENDENCY: needs the grading columns and/or the missing Lakehouse shortcuts. See MODEL_NOTES.md.
	measure 'Precision (Reportable)' = ```
			VAR C = SELECTEDVALUE ( alerts[maturity_cohort] )
			RETURN
			    IF ( C = "graded_T90_T60", [Precision (Ground Truth)], BLANK () )
			```
		formatString: 0.0%
		displayFolder: 04 Precision

	/// Rules passing in the latest RUN, scoped by run_id. dq_results keeps every
	/// run and never overwrites, so an unfiltered count would sum history and
	/// always look healthy -- but run_time is a per-rule stamp, so scoping by it
	/// counts one rule (P25 S7 read-back defect). The floor is required for every
	/// rule; the independent downstream check is required for rules 1-3 and is
	/// BLANK by design for 4-6 (contract SS7), so BLANK counts as passing. A rule
	/// that found nothing but proved it read nothing still has not passed -- that
	/// is what floor_satisfied encodes.
	measure 'DQ Rules Passed' = ```
			VAR LatestTime =
			    CALCULATE ( MAX ( dq_results[run_time] ), ALL ( dq_results ) )
			VAR LatestRunId =
			    CALCULATE (
			        MAX ( dq_results[run_id] ),
			        ALL ( dq_results ),
			        dq_results[run_time] = LatestTime
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                dq_results,
			                dq_results[run_id] = LatestRunId
			                    && dq_results[floor_satisfied] = TRUE ()
			                    && ( ISBLANK ( dq_results[independent_check_passed] )
			                        || dq_results[independent_check_passed] = TRUE () )
			            )
			        ),
			        ALL ( dq_results )
			    )
			```
		formatString: 0
		displayFolder: 05 Data quality

	/// Rows flagged across every rule in the latest RUN, scoped by run_id.
	/// RENAMED from 'DQ Faults Found' 2026-08-19 (Session 7) because that noun
	/// was wrong: rule 5 (payload_schema_evolution) contributes 2,151,584 of the
	/// 2,185,579, and its own detail JSON calls those rows carrying the v2
	/// sca_flag -- a population, not a fault. Rule 4 likewise reports all 1,500
	/// terminals as having nonzero clock skew, which is the expected state. The
	/// sum is kept whole rather than narrowed to a hard-coded list of 'real
	/// fault' rules, because that list would rot the moment a rule is added; the
	/// DqTbl beneath the card shows the per-rule split. Guide SS94.
	measure 'DQ Rows Flagged' = ```
			VAR LatestTime =
			    CALCULATE ( MAX ( dq_results[run_time] ), ALL ( dq_results ) )
			VAR LatestRunId =
			    CALCULATE (
			        MAX ( dq_results[run_id] ),
			        ALL ( dq_results ),
			        dq_results[run_time] = LatestTime
			    )
			RETURN
			    CALCULATE (
			        SUM ( dq_results[faults_found] ),
			        ALL ( dq_results ),
			        dq_results[run_id] = LatestRunId
			    )
			```
		formatString: #,0
		displayFolder: 05 Data quality
